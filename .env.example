# fluxpay-frontend (merchant dashboard + hosted checkout). Copy to .env.local.
# Backend API base URL, used by the server-side proxy (/api/proxy/*) and auth routes.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# No Razorpay variables needed here: the public key id comes from the backend with each
# checkout session, so the browser always uses the same key the order was created with.
# Never put RAZORPAY_KEY_SECRET in any frontend env file.
